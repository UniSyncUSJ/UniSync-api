                {
                  "key": "facultyAdminId",
                  "value": "{{admin_id_2}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/test/create-department-with-admin",
              "host": [
                "{{base_url}}"
