    {
      "name": "Test Endpoints",
      "item": [
        {
          "name": "Create Test Admins",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test for successful admin creation",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains admin IDs\", function () {",
                  "    var responseText = pm.response.text();",
                  "    pm.expect(responseText).to.include(\"Admins created successfully with ID:\");",
                  "});",
                  "",
                  "// Extract admin IDs from response and set as environment variables",
                  "var responseText = pm.response.text();",
                  "var lines = responseText.split('\\n');",
                  "if (lines.length >= 2) {",
                  "    var adminId1 = lines[1].trim();",
                  "    var adminId2 = lines[2].trim();",
                  "    pm.environment.set(\"admin_id_1\", adminId1);",
                  "    pm.environment.set(\"admin_id_2\", adminId2);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test/create-admins",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "create-admins"
              ]
            },
            "description": "Create test admin users. This endpoint creates:\n1. John Doe (johndoe@example.com) - Department Admin\n2. John Adams (johnadams@example.com) - Faculty Admin\n\nBoth users have password 'john123'"
          },
          "response": []
        },
        {
          "name": "Create Department with Admin - Valid IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Department created successfully\", function () {",
                  "    var responseText = pm.response.text();",
                  "    pm.expect(responseText).to.include(\"Department created under Admin ID:\");",
                  "    pm.expect(responseText).to.include(\"Department ID:\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "facultyAdminId",
                  "value": "{{admin_id_2}}",
                  "type": "text",
                  "description": "Faculty Admin ID (John Adams)"
                },
                {
                  "key": "deptAdminId",
                  "value": "{{admin_id_1}}",
                  "type": "text",
                  "description": "Department Admin ID (John Doe)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/test/create-department-with-admin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "create-department-with-admin"
              ]
            },
            "description": "Create a department with admin. This creates:\n1. Science Faculty with Faculty Admin\n2. Computer Science Department under the Faculty with Department Admin\n\nUse the admin IDs from the create-admins endpoint."
          },
          "response": []
        },
        {
          "name": "Create Department with Admin - Invalid Faculty Admin ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message for invalid faculty admin ID\", function () {",
                  "    var responseText = pm.response.text();",
                  "    pm.expect(responseText).to.include(\"not found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "facultyAdminId",
                  "value": "999",
                  "type": "text",
                  "description": "Invalid Faculty Admin ID"
                },
                {
                  "key": "deptAdminId",
                  "value": "{{admin_id_1}}",
                  "type": "text",
                  "description": "Valid Department Admin ID"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/test/create-department-with-admin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "create-department-with-admin"
              ]
            },
            "description": "Test with invalid faculty admin ID to verify error handling"
          },
          "response": []
        },
